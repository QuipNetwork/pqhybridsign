# Transient worktrees created for parallel agent runs. Never part of a commit.
/.claude/worktrees/
/.plans/
# Subagent-driven-development scratch: ledger, briefs, reports, review packages.
/.superpowers/

# Rust
/target
Cargo.lock.bak

# cargo-mutants output: written at the repository root, rotated into
# mutants.out.old/ on each run. Build output, never committed.
/mutants.out/
/mutants.out.old/

# Python packaging build output (maturin/twine)
/dist/

# Packed npm tarball (npm pack output; release:validate artifacts, never committed)
crates/pqhybridsign-wasm/npm/*.tgz
# TypeScript example build output. The lock file stays out too: before the
# npm package is published it can only record a file: URL into this tree.
examples/typescript/dist/
examples/typescript/node_modules/
examples/typescript/package-lock.json

# Python bytecode
__pycache__/
*.pyc
